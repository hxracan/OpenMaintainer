NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DASHBOARD_URL=http://localhost:3000
API_URL=http://127.0.0.1:4000
DATABASE_URL=postgres://openmaintainer:development-only@localhost:5432/openmaintainer
# Docker Compose requires a strong password and DATABASE_URL hostname postgres:
POSTGRES_PASSWORD=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
ALLOW_AUTOMATION_WRITES=false
# Optional absolute path to a CLI-created trusted plugin registry:
OPENMAINTAINER_PLUGINS=
