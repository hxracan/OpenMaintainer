{
  "name": "openmaintainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "build": "turbo run build",
    "test:e2e": "playwright test",
    "dev": "tsx scripts/dev.ts",
    "demo": "tsx scripts/demo.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "cli": "tsx packages/cli/src/main.ts",
    "docs:build": "pnpm --filter @openmaintainer/docs build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "marked": "^18.0.14",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "turbo": "2.11.4",
    "typescript": "~5.9.3",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@types/picomatch": "^4.0.2",
    "@types/semver": "^7.7.1",
    "commander": "^15.0.0",
    "fastify": "5.12.5",
    "pg": "^8.16.3",
    "picomatch": "^4.0.3",
    "pino": "^10.0.0",
    "semver": "^7.7.3",
    "yaml": "^2.8.2",
    "zod": "4.6.5"
  }
}
